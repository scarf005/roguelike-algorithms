+// Temporary Phase 1 observation hook; never reads RNG or changes pmap.
+void phase1Dump(const char *stage) {
+    const char *out = getenv("PHASE1_OUT");
+    if (!out) return;
+    char path[1024];
+    snprintf(path, sizeof(path), "%s/%d-%s.txt", out, rogue.depthLevel, stage);
+    FILE *f = fopen(path, "w");
+    for (int y = 0; y < DROWS; y++) for (int x = 0; x < DCOLS; x++) {
+        for (int layer = 0; layer < NUMBER_TERRAIN_LAYERS; layer++)
+            fprintf(f, "%d ", pmap[x][y].layers[layer]);
+        fprintf(f, "\n");
+    }
+    fclose(f);
+}
