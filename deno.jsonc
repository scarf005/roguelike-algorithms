{
  "fmt": {
    "semiColons": false,
    "proseWrap": "never",
    "exclude": ["dist"]
  },
  "lint": {
    "exclude": ["dist"]
  },
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:vite",
    "build": "deno run -A --node-modules-dir npm:vite build",
    "typecheck": "deno check src/main.tsx src/**/*.test.ts",
    "lint": "deno lint",
    "test": "deno test",
    "preview": "deno run -A --node-modules-dir npm:vite preview"
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable", "deno.ns"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.4",
    "solid-js": "npm:solid-js@^1.9.15",
    "vite": "npm:vite@^8.3.1",
    "vite-plugin-solid": "npm:vite-plugin-solid@^2.11.14"
  }
}
